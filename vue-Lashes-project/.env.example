# 复制为 .env.local 后填入真实值（勿提交 .env.local）

# 预约数据源（未设 VITE_USE_REST_API=true 时）：Supabase > 通用 REST（VITE_API_BASE_URL）> localStorage
# 设置 VITE_USE_REST_API=true 且配置 VITE_API_BASE_URL 后：FastAPI REST 优先，失败再回落 Supabase / localStorage
# 配置 Supabase 后：请在控制台执行 supabase/schema.sql，并在 Authentication 中创建管理员用户。

# Supabase（Project Settings → API）
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im1weHR4aGJ3Y2xuendzaHp1bGF4Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzUzMDA3NDMsImV4cCI6MjA5MDg3Njc0M30.bTVCrQGBgtPDwOFukGpX6em7yG_I33LPRj4MymtVfjY

# 本地 FastAPI（backend/ uvicorn 默认 8000）
VITE_USE_REST_API=true
VITE_API_BASE_URL=http://127.0.0.1:8000

# --- 管理员登录（仅 FastAPI 读取，勿写进 VITE_*）---
# JWT 签名密钥（>=16 字符）
# FASTAPI_JWT_SECRET=your-long-random-secret-here
# 管理员登录共享口令（与 Supabase Auth 无关）
# FASTAPI_ADMIN_PASSWORD=change-me
# 可选：未写入 admin_emails 表时的后备邮箱列表
# ADMIN_EMAILS=owner@example.com
# 可选：若希望用 Supabase access_token 调受保护接口，填 Dashboard → JWT Secret
# SUPABASE_JWT_SECRET=

# --- FastAPI 后端（在 backend/ 下启动 uvicorn 时读取；勿与 VITE_* 混用）---
# 连「同一套」Supabase Postgres 时：用 Dashboard 里 Database 连接串，并写成 SQLAlchemy 形式，例如：
# DATABASE_URL=postgresql+psycopg2://postgres.[ref]:[PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres
# 须已执行 supabase/schema.sql，使 public.bookings 存在且与后端 ORM 一致。
# 本地零配置演示（SQLite，非 Supabase 数据）：
DATABASE_URL=sqlite:///./app.db

# 通知链路（预约成功后优先邮件，不可用时走短信模拟）
# 管理员通知邮箱（多个逗号分隔）
# VITE_BOOKING_ADMIN_EMAILS=owner@example.com,manager@example.com

# 可选：Supabase Edge Function 名称（默认 booking-notify）
# VITE_SUPABASE_NOTIFY_FUNCTION=booking-notify

# 可选：支付页随机进入「失败结果」的概率 0～1（不设则始终走成功回调，便于本地调试）
# VITE_PAYMENT_SIMULATE_FAIL_PROB=0.2

# --- AI 服务推荐（Edge Function `service-recommend`，见 supabase/functions/service-recommend）---
# 服务端调用 DeepSeek（OpenAI 兼容 Chat Completions + json_object）。Supabase Secrets 示例：
#   supabase secrets set DEEPSEEK_API_KEY=sk-...
#   可选：DEEPSEEK_MODEL（默认 deepseek-chat）、DEEPSEEK_API_BASE_URL（默认 https://api.deepseek.com）
# 部署：supabase functions deploy service-recommend
# VITE_ENABLE_OPENAI_SERVICE_RECOMMEND=true
# VITE_SUPABASE_SERVICE_RECOMMEND_FUNCTION=service-recommend
