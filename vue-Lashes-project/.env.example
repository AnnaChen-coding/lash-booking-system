# 复制为 .env.local 后按需修改（勿提交 .env.local）

# Vue 前端 → FastAPI 后端
VITE_API_BASE_URL=http://127.0.0.1:8000

# 预约成功通知：管理员邮箱（逗号分隔，可选）
# VITE_BOOKING_ADMIN_EMAILS=owner@example.com

# 可选：支付页随机进入「失败结果」的概率 0～1
# VITE_PAYMENT_SIMULATE_FAIL_PROB=0.2

# --- FastAPI 后端（backend/.env，勿与 VITE_* 混用）---
# 本地开发默认 SQLite；生产可改为 PostgreSQL：
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./app.db

# JWT 签名密钥（>=16 字符）
# FASTAPI_JWT_SECRET=your-long-random-secret-here

# 管理员登录口令
# FASTAPI_ADMIN_PASSWORD=change-me

# 允许登录的管理员邮箱（逗号分隔）；也可写入数据库表 admin_emails
# ADMIN_EMAILS=owner@example.com
